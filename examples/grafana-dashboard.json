{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Pandora",
  "uid": "pandora-exporter",
  "schemaVersion": 39,
  "version": 6,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Напряжение АКБ",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_battery_voltage_volts",
          "legendFormat": "{{device_id}} {{state}} {{sim}} {{currency}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "volt"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Уровень топлива",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_fuel_ratio",
          "legendFormat": "{{device_id}} {{state}} {{sim}} {{currency}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Температуры",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_engine_temperature_celsius",
          "legendFormat": "{{device_id}} — Двигатель"
        },
        {
          "refId": "B",
          "expr": "pandora_cabin_temperature_celsius",
          "legendFormat": "{{device_id}} — Салон"
        },
        {
          "refId": "C",
          "expr": "pandora_ambient_temperature_celsius",
          "legendFormat": "{{device_id}} — За бортом"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Скорость",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_speed_meters_per_second * 3.6",
          "legendFormat": "{{device_id}} {{state}} {{sim}} {{currency}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Пробег GPS / CAN",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_gps_mileage_meters / 1000",
          "legendFormat": "{{device_id}} — GPS"
        },
        {
          "refId": "B",
          "expr": "pandora_can_mileage_meters / 1000",
          "legendFormat": "{{device_id}} — CAN"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthkm"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Обороты двигателя",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_engine_rpm",
          "legendFormat": "{{device_id}} {{state}} {{sim}} {{currency}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Охрана / тревога / двигатель",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_state{state=~\"armed|alarm|engine_running\"}",
          "legendFormat": "{{device_id}} {{state}} {{sim}} {{currency}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Возраст данных",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_data_age_seconds",
          "legendFormat": "{{device_id}} {{state}} {{sim}} {{currency}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Опрос API",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_scrape_success",
          "legendFormat": "{{device_id}} {{state}} {{sim}} {{currency}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Баланс SIM",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_sim_balance",
          "legendFormat": "{{device_id}} {{state}} {{sim}} {{currency}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Уровень сигнала GSM",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_gsm_level",
          "legendFormat": "{{device_id}} — GSM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "Двери / багажник / капот",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_state{state=\"front_left_door_open\"}",
          "legendFormat": "{{device_id}} — Передняя левая открыта"
        },
        {
          "refId": "B",
          "expr": "pandora_state{state=\"front_right_door_open\"}",
          "legendFormat": "{{device_id}} — Передняя правая открыта"
        },
        {
          "refId": "C",
          "expr": "pandora_state{state=\"rear_left_door_open\"}",
          "legendFormat": "{{device_id}} — Задняя левая открыта"
        },
        {
          "refId": "D",
          "expr": "pandora_state{state=\"rear_right_door_open\"}",
          "legendFormat": "{{device_id}} — Задняя правая открыта"
        },
        {
          "refId": "E",
          "expr": "pandora_state{state=\"trunk_open\"}",
          "legendFormat": "{{device_id}} — Багажник открыт"
        },
        {
          "refId": "F",
          "expr": "pandora_state{state=\"hood_open\"}",
          "legendFormat": "{{device_id}} — Капот открыт"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Нет"
                },
                "1": {
                  "text": "Да"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "background"
      },
      "description": "Статусы отображаются карточками, последнее значение."
    },
    {
      "id": 13,
      "title": "Состояния автомобиля",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_state{state=\"immobilizer\"}",
          "legendFormat": "{{device_id}} — Двигатель заблокирован"
        },
        {
          "refId": "B",
          "expr": "pandora_moving",
          "legendFormat": "{{device_id}} — В движении"
        },
        {
          "refId": "C",
          "expr": "pandora_state{state=\"ignition\"}",
          "legendFormat": "{{device_id}} — Зажигание"
        },
        {
          "refId": "D",
          "expr": "pandora_state{state=\"brake\"}",
          "legendFormat": "{{device_id}} — Тормоз"
        },
        {
          "refId": "E",
          "expr": "pandora_state{state=\"parking_brake\"}",
          "legendFormat": "{{device_id}} — Нейтраль (parking)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Нет"
                },
                "1": {
                  "text": "Да"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "background"
      },
      "description": "Нейтраль соответствует HA-сенсору parking: бит 27 bit_state_1. В API этот бит описан как ручной тормоз; интерпретация зависит от автомобиля и настройки сигнализации. Статусы отображаются карточками, последнее значение."
    },
    {
      "id": 14,
      "title": "Моточасы",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_engine_hours",
          "legendFormat": "{{device_id}} — Моточасы"
        },
        {
          "refId": "B",
          "expr": "pandora_can_engine_hours",
          "legendFormat": "{{device_id}} — Моточасы CAN"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Значения motohours и motohours_CAN из API, в часах. При отсутствии данных серия не отображается."
    },
    {
      "id": 15,
      "title": "Расположение автомобилей",
      "type": "geomap",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_latitude_degrees",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "pandora_longitude_degrees",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "device_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "latitude",
              "Value #B": "longitude"
            },
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 55.75,
          "lon": 37.62,
          "zoom": 4
        },
        "controls": {
          "showZoom": true,
          "showLegend": true,
          "showAttribution": true
        },
        "tooltip": {
          "mode": "details"
        },
        "basemap": {
          "config": {},
          "name": "Layer 0",
          "type": "default"
        },
        "layers": [
          {
            "config": {
              "style": {
                "color": {
                  "fixed": "#5794F2"
                },
                "size": {
                  "fixed": 8
                },
                "symbol": "img/icons/marker/circle.svg"
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "name": "Автомобили",
            "tooltip": true,
            "type": "markers"
          }
        ]
      },
      "description": "Координаты берутся из pandora_latitude_degrees и pandora_longitude_degrees."
    }
  ],
  "tags": [
    "pandora"
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
