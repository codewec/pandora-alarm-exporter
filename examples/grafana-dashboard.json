    {
      "id": 15,
      "title": "Расположение и маршрут",
      "type": "geomap",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pandora_latitude_degrees",
          "format": "table",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "pandora_longitude_degrees",
          "format": "table",
          "instant": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
          "byField": "Time",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "latitude",
              "Value #B": "longitude",
              "Value": "latitude",
              "Value 1": "longitude"
            },
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 0,
          "lon": 0,
          "zoom": 2
        },
        "controls": {
          "showZoom": true,
          "showLegend": true,
          "showAttribution": true
        },
        "tooltip": {
          "mode": "details"
        },
        "basemap": {
          "config": {},
          "name": "Layer 0",
          "type": "default"
        },
        "layers": [
          {
            "config": {
              "style": {
                "color": {
                  "fixed": "#5794F2"
                },
                "size": {
                  "fixed": 8
                },
                "symbol": "img/icons/marker/circle.svg"
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "name": "Автомобили",
            "tooltip": true,
            "type": "markers"
          },
          {
            "config": {
              "style": {
                "color": {
                  "fixed": "#FF7800"
                },
                "width": {
                  "fixed": 3
                }
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "name": "Маршрут",
            "tooltip": true,
            "type": "route"
          }
        ]
      },
      "description": "Пустая карта открывается с видом на весь мир. Точка появляется только при наличии валидных координат Pandora."
